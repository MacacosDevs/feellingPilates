SPRING_PROFILES_ACTIVE=dev

DB_HOST=localhost
DB_PORT=5432
DB_NAME=FeelingPilates
DB_USER=feelingpilates
DB_PASSWORD=feelingpilates

# JWT (usa un secreto aleatorio de al menos 32 bytes)
JWT_SECRETO=cambia-este-secreto-en-produccion-minimo-32-bytes!
JWT_EXPIRACION_SEGUNDOS=86400

# Web Client ID de OAuth creado en Google Cloud Console (termina en
# .apps.googleusercontent.com) — el mismo valor va en GOOGLE_WEB_CLIENT_ID
# de la app móvil (feellingPilatesApp/src/config/googleAuth.ts)
GOOGLE_CLIENT_ID=

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGENES_PERMITIDOS=http://localhost:5173

# URL del frontend (para construir el enlace de invitación que se envía por correo)
FRONTEND_URL=http://localhost:5173
# Vigencia del enlace de invitación de clientes, en horas (168 = 7 días)
INVITACION_EXPIRACION_HORAS=168

# Claves de Stripe (modo prueba: sk_test_/pk_test_). La secreta solo vive aquí,
# la publicable es la misma que usa la app móvil (feellingPilatesApp/src/config/env.ts)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Firma del webhook de Stripe (Dashboard > Developers > Webhooks), para verificar
# que los eventos de confirmación de pago vienen realmente de Stripe
STRIPE_WEBHOOK_SECRET=
