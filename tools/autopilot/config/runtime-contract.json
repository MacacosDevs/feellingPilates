{
  "contract_version": "r2",
  "runtime": {
    "python": "3.14-compatible"
  },
  "primary_sdk": {
    "package": "openai-codex",
    "tested_version": "0.147.0"
  },
  "fallback_cli": {
    "package": "codex-cli",
    "tested_version": "0.150.1"
  },
  "r4_cli_adapter": {
    "role": "IMPLEMENTED_CANDIDATE_FALLBACK_DIAGNOSTIC",
    "implementation": "IMPLEMENTED",
    "publication": "PUBLISHED",
    "routing": "FALLBACK",
    "purpose": "DIAGNOSTIC",
    "structured_protocol": "IMPLEMENTED_CANDIDATE",
    "session_resume": "IMPLEMENTED_CANDIDATE",
    "timeout_cancellation_process_cleanup": "IMPLEMENTED_CANDIDATE",
    "reasoning_effort": {
      "mechanism": "-c model_reasoning_effort=value",
      "allowed_values": ["low", "medium", "high", "xhigh"]
    },
    "workspace_authorization": "BOUNDED_TO_CONFIGURED_ROOT"
  },
  "r5_sdk_adapter": {
    "role": "IMPLEMENTED_CANDIDATE_PRIMARY",
    "package": "openai-codex==0.147.0",
    "structured_result": "STRICT_R2_R4_SEMANTICS",
    "session_resume": "IMPLEMENTED_CANDIDATE",
    "timeout_cancellation": "IMPLEMENTED_CANDIDATE",
    "event_collection": "BOUNDED",
    "authentication": "LOCAL_CHATGPT_CODEX_LOGIN_NO_MANDATORY_API_KEY"
  },
  "architecture": {
    "python_sdk": "PRIMARY_ARCHITECTURE",
    "automatic_fallback_routing": "NOT_IMPLEMENTED",
    "workflow_engine": "NOT_IMPLEMENTED",
    "publisher": "NOT_IMPLEMENTED"
  },
  "state_backend": {
    "package": "sqlite3",
    "source": "stdlib",
    "tested_sqlite_baseline": "3.53.3",
    "durable_state": {
      "connection_contract": {
        "foreign_keys": true,
        "journal_mode": "WAL",
        "synchronous": "FULL",
        "busy_timeout_ms": "configured"
      },
      "migration_checksum": "sha256-raw-file-bytes-lowercase-hex",
      "lease_expiry": "utc-wall-clock-current-time-greater-than-or-equal-to-expires-at",
      "fencing_scope": "per-protected_resource_key",
      "backup": "sqlite3-connection-backup-explicit-destination"
    }
  },
  "authentication": {
    "chatgpt_local_codex_login_supported_by_r1_evidence": true
  },
  "auto_publish": false,
  "telemetry": {
    "unavailable_token_classes": null,
    "synthetic_zero_for_unavailable": "forbidden",
    "fabricated_usage": "forbidden",
    "heuristic_decomposition_as_observed": "forbidden",
    "observed_value_requires_direct_evidence": true,
    "derived_or_estimated_usage_must_be_explicitly_labeled": true
  }
}
