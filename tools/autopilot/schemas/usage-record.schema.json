{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feelingpilates.local/autopilot/schemas/usage-record.schema.json",
  "title": "Autopilot usage record",
  "type": "object",
  "required": ["schema_version", "adapter", "measurements"],
  "properties": {
    "schema_version": {"const": "r2"},
    "adapter": {"type": "string", "minLength": 1},
    "measurements": {
      "type": "object",
      "required": ["input_tokens", "cached_input_tokens", "output_tokens", "reasoning_output_tokens", "total_tokens"],
      "properties": {
        "input_tokens": {"$ref": "#/$defs/token_measurement"},
        "cached_input_tokens": {"$ref": "#/$defs/token_measurement"},
        "output_tokens": {"$ref": "#/$defs/token_measurement"},
        "reasoning_output_tokens": {"$ref": "#/$defs/token_measurement"},
        "total_tokens": {"$ref": "#/$defs/token_measurement"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "token_measurement": {
      "type": "object",
      "required": ["value", "provenance", "direct_evidence"],
      "properties": {
        "value": {"type": ["integer", "null"], "minimum": 0},
        "provenance": {"enum": ["OBSERVED", "UNAVAILABLE"]},
        "direct_evidence": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"provenance": {"const": "OBSERVED"}}},
          "then": {
            "properties": {
              "value": {"type": "integer", "minimum": 0},
              "direct_evidence": {"type": "string", "minLength": 1}
            }
          }
        },
        {
          "if": {"properties": {"provenance": {"const": "UNAVAILABLE"}}},
          "then": {
            "properties": {
              "value": {"type": "null"},
              "direct_evidence": {"type": "null"}
            }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
